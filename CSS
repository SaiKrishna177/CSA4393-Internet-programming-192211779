body {
  font-family: sans-serif;
  background: #f4f4f4;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.login-box {
  background: #fff;
  padding: 20px;
  border-radius: 6px;
  box-shadow: 0 0 10px #ccc;
  width: 280px;
}

h2 {
  text-align: center;
}

input[type="text"],
input[type="password"],
input[type="submit"] {
  width: 100%;
  padding: 8px;
  margin: 10px 0;
  box-sizing: border-box;
}

input[type="submit"] {
  background: #28a745;
  color: #fff;
  border: none;
  cursor: pointer;
}

input[type="submit"]:hover {
  background: #218838;
}
